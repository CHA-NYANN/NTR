# Event dinamis Nagisa, Alur_Cabang/02. Lokasi ayunan mengikuti harapan
# Nagisa pada Koita yang turun hari ini, termasuk saat pemain sedang jauh.
# ┌─ PANDUAN CERITA · N-D03 · Ayunan Malam
# │ LOKASI  : (dinamis — muncul dari kondisi)
# │ TERLIBAT: Sakurajima Nagisa
# │ AWALAN  : hari itu harapan_koita turun
# │ INTI    : A Duduk di ayunan sebelah / B panggil Koita / C beri ruang
# │ AKHIRAN : kelekatan +; bila Koita yang datang, hasilnya tergantung Koita
# └─ tulis / perbaiki dialog di bawah ──
label kkscene_N_D03:
    call kk_scene_enter("nagisa", "Taman Lingkungan · Ayunan malam")
    nar "Lampu taman yang menyala kekuningan menyinari area ayunan yang sudah sepi. Nagisa duduk di salah satu ayunan besi sambil menjejakkan ujung sepatunya ke tanah agar papan kayu itu tidak bergerak. Tangannya merah oleh angin malam, tanda ia sudah duduk di sana cukup lama hingga lupa dingin."
    if kk_host == "chiasa":
        chiasa "Nagisa-senpai? Malam-malam begini sendirian di taman? Tanganmu dingin banget lho itu."
        nagisa "Kalau kamu datang cuma buat bilang Ko-kun sebenarnya sibuk dan nggak bermaksud begitu, mending nggak usah, Chiasa. Malam ini aku lagi pengin kesal tanpa dibantu cari alasan buat membelanya. Ayunan sebelah kosong tuh kalau mau duduk."
    else:
        yutaka "Nagisa? Duduk sendirian di ayunan malam-malam begini? Nanti masuk angin lho."
        nagisa "Kalau kamu datang cuma buat bilang Ko-kun sebenarnya perhatian dan lagi banyak urusan, simpan aja, Yutaka. Aku lagi pengin kesal dulu tanpa ada yang repot-repot membelanya. Ayunan sebelah kosong kalau kamu mau duduk."
    call kk_family_menu("N-D03", ["Duduk di ayunan sebelah.", "Tawarkan untuk memanggil Koita.", "Beri dia ruang."])
    if _return == "A":
        nar "Kamu melangkah mendekat lalu duduk pelan di ayunan sebelahnya, membiarkan rantai besi berderit pelan di udara malam sebelum bersuara."
        if kk_host == "chiasa":
            chiasa "Aku nggak bakal belain Ko-nii kok malam ini. Kalau Nagisa-senpai mau cerita, aku dengerin. Kalau cuma mau duduk diam juga nggak apa-apa."
        else:
            yutaka "Tenang aja, aku nggak bawa pidato pembelaan buat Koita malam ini. Kamu mau cerita, atau cuma mau duduk sebentar di sini?"
        nar "Nagisa menunduk menatap ujung sepatunya yang menggores pasir halus di bawah ayunan."
        nagisa "Aku cuma capek banget jadi orang yang selalu disuruh ngerti kenapa dia nggak bisa datang. Tiap kali batal, aku selalu bilang nggak apa-apa... padahal kadang aku cuma pengin sekali aja dia yang tanya kenapa aku masih nunggu."
        nar "Ia mengusap sudut matanya cepat lalu menyalahkan angin malam yang berembus kencang. Kamu ikut memandang lurus ke lapangan taman tanpa memaksanya segera tersenyum, membiarkan ia duduk tenang selama yang ia perlukan."
    elif _return == "B":
        if kk_daily_place("koita") == "Taman Lingkungan":
            if kk_host == "chiasa":
                chiasa "Bentar ya, Nagisa-senpai, tadi aku lihat Ko-nii masih di dekat jalan masuk taman. Kupanggilkan ke sini aja biar kalian bicara langsung."
            else:
                yutaka "Kebetulan Koita tadi masih di sekitar ujung taman ini. Mau kupanggilkan ke sini sekarang biar kalian selesaiin langsung?"
            nar "Tidak lama kemudian, langkah tergesa terdengar mendekat dan Koita berhenti di bawah tiang lampu taman."
            koita "Nagisa-chan? Kamu di sini rupanya? Tadi aku cariin... kamu mau bicara?"
            nar "Nagisa menoleh dengan bahu terkejut karena orang yang baru saja ia keluhkan benar-benar berdiri di hadapannya. Ia terdiam dua detik, menimbang antara melampiaskan marahnya atau memberi satu kesempatan terakhir untuk mendengar."
            nagisa "Iya, Ko-kun. Tapi kali ini kamu dengar dulu sampai selesai. Jangan langsung bilang nggak apa-apa sebelum aku bilang bagian mana yang bikin aku sakit hati."
            koita "...Baik. Aku duduk sini dan dengerin, Nagisa-chan."
        else:
            if kk_host == "chiasa":
                chiasa "Mau kuteleponkan Ko-nii supaya ke sini sekarang, Nagisa-senpai? Biar nggak terus kamu pendam sendiri."
            else:
                yutaka "Kalau kamu mau bicara langsung sama dia, biar kutelepon Koita sekarang supaya nyusul ke taman."
            nar "Koita sedang tidak berada di sekitar taman. Nagisa mendengarkan tawaranmu sejenak, lalu menggeleng pelan tanpa menatap wajahmu."
            nagisa "Nggak usah. Aku nggak mau ngerasa dia datang ke sini lagi-lagi cuma gara-gara disuruh atau dijemput orang lain. Malam ini biarkan dulu aja."
    else:
        if kk_host == "chiasa":
            chiasa "Baiklah, aku nggak mengganggu dulu ya, Nagisa-senpai. Tapi jangan kelamaan kena angin malam, nanti masuk angin."
        else:
            yutaka "Oke, kukasih kamu ruang sendiri dulu ya, Nagisa. Kalau sudah agak tenang jangan lupa langsung pulang, malam ini dingin."
        nagisa "...Iya. Hati-hati pulangnya."
        nar "Suaranya turun sangat pelan. Ketika kamu berjalan menjauh keluar gerbang taman, ayunan besi di sebelah Nagisa tetap diam bergantung, dan malam itu kamu memilih tidak menoleh lagi agar ia mendapat jarak yang tenang."
    return

# ┌─ PANDUAN CERITA · N-D08 · Rekaman Pertandingan
# │ LOKASI  : (dinamis — muncul dari kondisi)
# │ TERLIBAT: Sakurajima Nagisa
# │ AWALAN  : N02-B pernah terjadi; gengsi ≥ 60
# │ INTI    : A Akui / B sangkal / C tantang ulang dengan serius
# │ AKHIRAN : Trust dan gengsi bergeser
# └─ tulis / perbaiki dialog di bawah ──
label kkscene_N_D08:
    call kk_scene_enter("nagisa", "Studio Arsitektur · Rekaman permainan")
    nar "Di meja kosong sudut studio, layar konsol genggam Nagisa menyala menampilkan rekaman ulang pertandingan kalian waktu itu. Begitu kamu mendekat, ibu jarinya menekan tombol jeda tepat satu detik sebelum gerakan terakhirmu."
    nar "Ia rupanya sudah menyiapkan klip itu dengan rapi, lengkap dengan titik di mana celah kemenanganmu sengaja kamu lewatkan begitu saja."
    if kk_host == "chiasa":
        nagisa "Chiasa, lihat layar ini deh. Tadi aku putar ulang rekaman tanding kita. Di detik ini kamu jelas-jelas bisa menang sekali serang. Aku nggak sebodoh itu sampai nggak bisa bedain mana lengah beneran sama mana yang sengaja ngalah. Kenapa kamu mengalah waktu itu?"
    else:
        nagisa "Yutaka, coba lihat sini. Aku barusan nonton ulang rekaman tanding kita. Di titik ini kamu jelas-jelas bisa langsung menang. Aku nggak sebodoh itu sampai nggak tahu bedanya salah pencet sama sengaja ngalah. Kenapa kamu kasih kemenangan itu?"
    call kk_family_menu("N-D08", ["Akui kamu sengaja mengalah.", "Sangkal bahwa kamu sengaja kalah.", "Tantang dia lagi dan mainlah dengan serius."])
    if _return == "A":
        if kk_host == "chiasa":
            chiasa "Iya... maaf ya, Nagisa-senpai. Waktu itu aku memang sengaja nahan serangan terakhir karena pengin lihat Senpai senang menang."
        else:
            yutaka "Iya, ketahuan deh. Waktu itu aku memang sengaja nahan di akhir karena pengin bikin suasana hatimu enak aja, Nagisa."
        nar "Nagisa mendengarkan pengakuanmu sampai tuntas tanpa memotong, lalu menekan tombol daya konsol hingga layar gelap."
        nagisa "Dengar ya. Aku senang banget main bareng kamu, termasuk waktu aku kalah telak sekalipun. Tapi kalau kamu diam-diam mengalah begitu, nanti pas aku beneran menang aku malah nggak bisa percaya itu hasil usahaku sendiri."
        if kk_host == "chiasa":
            chiasa "Mengerti, Nagisa-senpai. Lain kali nggak bakal kuulang lagi."
        else:
            yutaka "Paham, Nagisa. Lain kali aku main serius penuh dari awal sampai habis."
        nagisa "...Awas kalau lupa. Besok kita tanding lagi satu set penuh, nggak ada ampun."
        nar "Tegurannya terasa tajam dan jujur. Meski begitu, caranya langsung mengajak tanding lagi menunjukkan ia masih mau mempercayaimu."
    elif _return == "B":
        if kk_host == "chiasa":
            chiasa "Nggak kok, Nagisa-senpai, waktu itu tanganku beneran kepeleset aja di tombol samping. Aku nggak sengaja ngalah sama sekali."
        else:
            yutaka "Nggak lah, Nagisa, waktu itu jariku memang lagi telat pencet aja. Kamu terlalu jauh mikirnya."
