# Kouseikan — engine. Poin, ambang, jadwal, Force (abstrak), resolver ending.
# Semua logika tersembunyi; pemain membaca lewat perilaku, bukan angka (✅ 6C.4).

init python:

    import math

    # ---- indeks data autogenerated ----
    KK_END_BY_CODE = {e["code"]: e for e in KK_ENDINGS}
    KK_EV_BY_ID = {e["id"]: e for e in KK_EVENTS_MAIN}
    def _char_of(evid):
        p2 = evid[:2]
        if p2 in ("Mi","Mo"): return {"Mi":"miyuki","Mo":"moeka"}[p2]
        return {"K":"koita","Y":"yutaka","C":"chiasa","N":"nagisa","H":"harumi","S":"shiori"}.get(evid[0],"?")
    KK_EV_BY_CHAR = {}
    for _e in KK_EVENTS_MAIN:
        KK_EV_BY_CHAR.setdefault(_char_of(_e["id"]), []).append(_e)

    def _clamp(v, lo=0, hi=100):
        return max(lo, min(hi, v))

    # ---- label kualitatif ----
    def kk_lvl(v):
        if v < 25: return "Rendah"
        if v < 55: return "Sedang"
        if v < 80: return "Tinggi"
        return "Sangat Tinggi"

    # ---- poin kondisi ----
    def kk_adj(name, delta):
        store.pts[name] = _clamp(store.pts.get(name, 0) + delta)
        return store.pts[name]
    def kk_get(name, default=0):
        return store.pts.get(name, default)

    # ---- hubungan 5 dimensi ----
    def kk_rel(cid, dim, delta):
        d = store.rel.setdefault(cid, {"aff":0,"trust":0,"intim":0,"jeal":0,"fear":0})
        d[dim] = _clamp(d.get(dim,0) + delta)
        return d[dim]
    def kk_rel_get(cid, dim):
        return store.rel.get(cid, {}).get(dim, 0)

    # ---- kepribadian host: terbentuk dari pilihan, tidak pernah dipilih langsung ----
    def kk_persona_nudge(style, n=1):
        if style in store.kk_persona:
            store.kk_persona[style] += n
    def kk_persona_label():
        total = sum(store.kk_persona.values())
        if total < 3:
            return "Belum terbaca"
        top = max(store.kk_persona, key=store.kk_persona.get)
        runner = sorted(store.kk_persona.values(), reverse=True)
        if len(runner) > 1 and runner[0] == runner[1]:
            return "Campuran, belum menonjol"
        return top.capitalize() + " (dari pola pilihanmu)"

    # ---- flag ----
    def kk_flag(name):
        if name not in store.flags: store.flags.append(name)
    def kk_has(name):
        return name in store.flags

    # ---- tahap rute ----
    def kk_stage(route, value=None):
        if value is None: return store.stage.get(route, 0)
        store.stage[route] = value
        return value

    # ---- log pilihan ----
    def kk_log(evid, key, note=""):
        store.choices_log.append({"ev":evid, "key":key, "note":note})
    def kk_done(evid):
        return any(l["ev"] == evid for l in store.choices_log)

    # ---- waktu ----
    def kk_month():
        b = store.KK_BACKBONE[store.kk_bulan - 1]
        return b[0]
    def kk_month_tuple():
        return store.KK_BACKBONE[store.kk_bulan - 1]
    def kk_slot_label():
        return store.KK_SLOTS[store.kk_slot]
    def kk_advance(slots=1):
        # maju slot; tubuh menanggung. Pemain tak wajib tidur.
        # Overflow slot = hari baru, BUKAN bulan baru. Bulan maju lewat timeskip eksplisit
        # (kk_next_month) atau peristiwa cerita — agar bulan tidak melesat karena aktivitas harian.
        for _ in range(slots):
            store.kk_slot += 1
            kk_adj_body("energi", -6)
            kk_adj_body("lapar", +5)
            if store.kk_slot >= len(store.KK_SLOTS):
                store.kk_slot = 0
                store.kk_hari_n += 1
                kk_adj_body("utang_tidur", +8)  # tidak tidur semalaman

    def kk_next_month():
        # Timeskip (✅ GDD 6N.1). Minggu-minggu berlalu; tubuh pulih sebagian.
        store.kk_bulan = min(36, store.kk_bulan + 1)
        store.kk_slot = 0
        store.kk_hari_n = 1
        store.body["energi"] = min(100, store.body.get("energi", 0) + 60)
        store.body["utang_tidur"] = max(0, store.body.get("utang_tidur", 0) - 40)
        store.body["lapar"] = 10
        return store.kk_bulan
    def kk_adj_body(name, delta):
        store.body[name] = _clamp(store.body.get(name, 0) + delta)
        return store.body[name]
    def kk_kelelahan_tier():
        # dari utang_tidur + energi rendah
        ut = store.body.get("utang_tidur", 0)
        en = store.body.get("energi", 100)
        skor = ut + (100 - en) * 0.5
        if skor < 20: return ("Segar", 0)
        if skor < 45: return ("Lelah", 1)
        if skor < 75: return ("Sangat Lelah", 2)
        if skor < 100: return ("Kurang Tidur Kronis", 3)
        return ("Ambruk", 4)

    # ---- jadwal NPC (9 lapis, disederhanakan untuk prototipe) ----
    def kk_npc_loc(npc):
        base = {
            "koita":  {0:"Rumah Amamiya",1:"Kampus Sastra",2:"Klub Sastra",3:"Rumah Amamiya",4:"Kamar (menulis)",5:"Konbini"},
            "miyuki": {0:"Membuat pastry",1:"RS Tachibana",2:"Bimbingan",3:"Perpustakaan Medis",4:"Belajar",5:"Tidur"},
            "nagisa": {0:"Rumah Sakurajima",1:"Studio Arsitektur",2:"Studio (maket)",3:"Rumah",4:"Game online",5:"Game online"},
            "harumi": {0:"Asrama (teh)",1:"Lab Sains",2:"Lab",3:"Perpustakaan",4:"Belajar",5:"Tidur"},
            "moeka":  {0:"Terlambat ke kampus",1:"Kuliah Fashion",2:"Rapat BEM",3:"DIY fashion",4:"Menjahit",5:"Konbini (03:00)"},
            "shiori": {0:"Diantar Kuroiwa",1:"Kuliah Ekonomi",2:"Klub Catur",3:"Rumah Saionji",4:"Shogi online",5:"Tidur"},
            "chiasa": {0:"Sarapan dgn Koita",1:"Studio Seni",2:"Studio (Haruka)",3:"Menggambar",4:"Proyek (01:00)",5:"Tidur"},
        }
        slot = store.kk_slot
        loc = base.get(npc, {}).get(slot, "—")
        # lapis 4: tahap rute menggeser jadwal
        st = store.stage.get(npc, 0)
        if npc == "moeka" and st >= 3 and slot in (1,2):
            loc = "Absen (hilang kontak)"
        if npc == "miyuki" and st >= 2 and slot in (3,4):
            loc = "RS sampai tengah malam"
        if npc == "nagisa" and st >= 3:
            loc = "Muncul di lokasimu"
        # lapis 9: variasi acak kecil (rollback-safe)
        if renpy.random.random() < 0.12:
            loc = loc + " (?)"
        return loc

    # ---- Force: abstrak, non-operasional ----
    # Aksi TIDAK ditampilkan (layar hitam). Fungsi ini hanya memasang akibat.
    # Lihat docs/Alur_Cabang/09_Force_dan_Kriminal.md §2.
    KK_FORCE_LAPOR = {"miyuki":30,"nagisa":65,"harumi":20,"moeka":20,"shiori":90,"chiasa":55,"koita":20}
    def kk_force_consequences(victim):
        kk_flag("force_" + victim)
        kk_flag("force_pernah")
        # deviasi: korban lepas dari Koita (Tinggi) — dihitung Sistem
        store.deviasi += 22
        # romansa korban dgn pelaku terkunci
        kk_flag("lock_romance_" + victim)
        # trauma (abstrak)
        kk_rel(victim, "fear", +40)
        kk_rel(victim, "trust", -60)
        # peluang terbongkar (ditentukan watak + saksi), disimpan untuk resolver
        store.pts["lapor_" + victim] = KK_FORCE_LAPOR.get(victim, 40)
        # jalur bersih butuh semua kecurigaan tetap rendah (§10) — ditandai belum tercemar
        if "force_bersih_" + victim not in store.flags:
            kk_flag("force_bersih_" + victim)  # masih bersih; event lain bisa mencabut

    # ---- resolver ending (nasib pemain) ----
    def kk_resolve_ending():
        # ending tersembunyi: celah sistem (§11)
        if store.koita_bebas_naskah:
            return "E-SI-18"
        # Chiasa × Yutaka saja = mati
        if store.kk_host == "chiasa" and kk_has("chiasa_yutaka_saja") and store.deviasi < 20:
            return "E-SI-06"
        # ambang tersembunyi (prototipe: 45)
        if store.deviasi >= 45:
            rap = store.sikap_sistem.get("selidik",0)
            if store.deviasi >= 75 and rap >= 2:
                return "E-SI-03"
            if store.deviasi >= 75:
                return "E-SI-01"
            return "E-SI-02"
        # gagal
        return "E-SI-05"

    def kk_ending_data(code):
        return KK_END_BY_CODE.get(code, {"code":code,"name":code,"type":"?","host":"?","cond":"","body":""})

    # ---- setup state baru ----
    def kk_setup_state():
        store.body = {"energi":100,"utang_tidur":0,"lapar":10,"kebersihan":100,
                      "kesehatan":100,"stres_host":0,"nyeri_sistem":0}
        store.rel = {}
        store.pts = {"kelelahan_miyuki":35,"stres_moeka":40,"kejelasan_harumi":20,
                     "kelekatan_nagisa":20,"respek_shiori":20,"marah_shiori":0}
        store.stage = {"miyuki":0,"nagisa":0,"harumi":0,"moeka":0,"shiori":0,
                       "chiasa":0,"koita_bl":0}
        store.flags = []
        store.choices_log = []
        store.deviasi = 0
        store.orbit_koita = 5
        store.runtuh_koita = 0
        store.trust_koita = 60
        store.koita_sadar = 0
        store.saldo = 500000 if store.kk_host == "yutaka" else 400000
        # heroine mencintai Koita (kecuali Shiori); ke host rendah
        for cid in ("miyuki","nagisa","harumi","moeka","chiasa"):
            store.rel[cid] = {"aff":78,"trust":40,"intim":30,"jeal":10,"fear":5}
        store.rel["shiori"] = {"aff":10,"trust":20,"intim":10,"jeal":5,"fear":5}
        store.rel["koita"]  = {"aff":40,"trust":60,"intim":40,"jeal":10,"fear":5}
        store.rel["yutaka"] = {"aff":30,"trust":55,"intim":30,"jeal":10,"fear":5}
